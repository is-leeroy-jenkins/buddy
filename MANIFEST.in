include requirements-runtime.txt requirements-desktop.txt requirements.txt
include README.md LICENSE.txt pyproject.toml
include *.py
include .streamlit/config.toml
recursive-include resources *.png *.ico
recursive-include boogr *.py *.ico *.png
prune stores
prune logging
prune logs
prune site
prune docs
prune models
prune ipynb
global-exclude __pycache__ *.py[cod] *.db *.sqlite secrets.toml .env
